# =============================================================================
# F.O.R.G.E — Git Ignore Configuration
# =============================================================================

# Byte-compiled / optimized files
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
.venv/
env/
venv/
ENV/

# Secrets, credentials and environment variables
.env
.env.*
*.env
*.key
*.pem
*.cert
credentials.json
token.json

# Operating System & IDE artifacts
.vscode/
.idea/
.vs/
*.swp
*.swo
Thumbs.db
Desktop.ini
.DS_Store

# Model checkpoints & large binary weights (> 100MB / untracked foundation weights)
*.pt
*.pth
*.bin
*.safetensors
*.ckpt
*.onnx
models/

# Raw video inputs (preserve source drone footage and terrestrial dashcams locally)
*.mp4
*.mov
*.avi
*.mkv
*.webm

# Generated outputs & scratch caches (default exclude)
outputs/
*.ply
*.npz
*.obj

# Intermediate test and rendering artifacts
.pytest_cache/
.coverage
htmlcov/
tests/test_inputs/
ScreenCapture_*
ScreenCamera_*
